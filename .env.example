# Copy to .env.local and fill in. Never commit .env.local.

# --- Portfolio chatbot (server-side only) ---
# Option A (recommended, FREE): Groq — create a key at https://console.groq.com/keys
AI_API_KEY=
# Optional. Defaults shown. Any OpenAI-compatible API works (Groq, OpenRouter, Cerebras, Mistral…)
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b

# Option B (paid): OpenAI — used only when AI_API_KEY is empty
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# Option C (free, local only): Ollama — Vercel cannot reach localhost
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3

# --- Site ---
# Production URL, used for SEO metadata, sitemap and robots.txt
NEXT_PUBLIC_SITE_URL=https://aysha-iram.vercel.app
